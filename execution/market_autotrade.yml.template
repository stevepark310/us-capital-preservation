name: CUBE Market Autotrade (10m)

# 자동 크론은 **미국 정규장**만 돈다(2026-11-21 18:41 동훈님 승인 '안 A' — 프리장은 수동·지시 개입만).
#   정규장 09:30–16:00 ET = 13:30–20:00 UTC (EDT) / 14:30–21:00 UTC (EST)
#   프리마켓 04:00–09:30 ET는 이 자동 크론에서 돌지 않는다 — 사람이 지시한
#   `intervene_trade.yml`(workflow_dispatch 1건)만 호가유형 61을 낼 수 있다.
# 실제 세션 판정은 `core/market_clock`(DST 자동)이 하고, `scripts/cloud_cycle.py market`이
# `core/session_routing`의 **auto_phases**를 확인한다:
#   · 정규장은 종전과 동일하게 게이트(`config/live_execution_gate.json`)만 맞으면 돈다.
#   · 프리장은 `manual_intervention_only=true`라 auto_phases에서 빠진다 → SKIPPED_PREMARKET_MANUAL.
#     (자동 프리장 매매를 열려면 `manual_intervention_only=false` + OOS 재검증이 필요하다.)
on:
  schedule:
    - cron: "4-59/10 13-21 * * 1-5"
  # Trigger one immediate guarded market cycle when today's live gate is changed.
  push:
    branches: [main]
    paths:
      - 'config/live_execution_gate.json'
  workflow_dispatch:
    inputs:
      dry_run:
        description: "판단만 실행(주문 없음)"
        type: boolean
        default: false

concurrency:
  group: cube-repo-writer       # pulse 워크플로와 같은 그룹 → 동시에 쓰지 않는다
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  market-cycle:
    runs-on: ubuntu-latest
    timeout-minutes: 25
    env:
      TZ: Asia/Seoul
      PYTHONUNBUFFERED: "1"
      NH_APP_KEY: ${{ secrets.NH_APP_KEY }}
      NH_APP_SECRET: ${{ secrets.NH_APP_SECRET }}
      NH_ACT_NO: ${{ secrets.NH_ACT_NO }}
      NH_IS_MOCK: "false"
      CUBE_CLOUD_DRY_RUN: ${{ (github.event_name == 'workflow_dispatch' && github.event.inputs.dry_run == 'true') && '1' || '0' }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0        # rebase 푸시에 전체 이력이 필요하다

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --quiet --upgrade pip
          pip install --quiet -r requirements.txt

      - name: Market cycle (autotrader · monitor · ledger · status)
        run: python3 scripts/cloud_cycle.py market

      - name: Commit & push (data + docs)
        if: always()
        run: |
          set -e
          git config user.name "cube-cloud-bot"
          git config user.email "cube-cloud-bot@users.noreply.github.com"
          git add data docs
          if git diff --staged --quiet; then
            echo "변경 없음 — 푸시 생략"
            exit 0
          fi
          git commit -m "chore(cloud): market cycle $(TZ=Asia/Seoul date '+%m-%d %H:%M') KST"
          for i in 1 2 3; do
            if git push origin HEAD:main; then echo "pushed"; exit 0; fi
            echo "push 재시도 $i — rebase 후 재시도"
            git pull --rebase --autostash origin main || true
          done
          echo "::warning::push 실패 — 다음 사이클에서 다시 시도합니다."
